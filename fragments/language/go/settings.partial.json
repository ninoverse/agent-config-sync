{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod:*)",
      "Bash(go tool:*)",
      "Bash(go run:*)",
      "Bash(go env:*)",
      "Bash(go version)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(gotestsum:*)",
      "Bash(govulncheck:*)",
      "Bash(go-licenses:*)",
      "Bash(make:*)"
    ],
    "deny": [
      "Bash(go clean -modcache:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "gofmt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go build ./... 2>/dev/null || printf '%s' '{\"systemMessage\":\"go build ./... is failing - the module does not compile. See CLAUDE.md: never leave the build broken.\"}'",
            "statusMessage": "go build",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
