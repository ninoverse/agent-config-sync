root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# rustfmt.toml is the authority for .rs files; these mirror it so editors
# without rust-analyzer loaded still do the right thing.
[*.rs]
indent_size = 4
max_line_length = 100

[*.{toml,yml,yaml,json,md}]
indent_size = 2

# Recipes are passed to a shell, where a leading tab is significant.
[justfile]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

# Trailing whitespace is meaningful in Markdown (two spaces = line break).
[*.md]
trim_trailing_whitespace = false
